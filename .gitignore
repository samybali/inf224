# --- Fichiers de Compilation (Temporaires) ---
*.o
*.obj
*.class

# --- Executables (Windows) ---
*.exe
*.dll

# --- Executables (Mac / Linux) ---
# Comme ils n'ont pas d'extension, il faut mettre leur nom exact
# Remplacez "mon_programme" par le nom défini dans votre Makefile (EXEC)
cpp/mon_programme
cpp/myprog
cpp/server
cpp/client
a.out


# --- Fichiers de dépendances générés ---
cpp/depend-prog
cpp/depend-myprog
cpp/depend-client
cpp/depend-server
.depend

# --- Fichiers Système (Junk) ---
.DS_Store       # Poubelle Mac
Thumbs.db       # Poubelle Windows

# --- Configuration VS Code (Optionnel mais recommandé) ---
# On ne partage généralement pas sa config perso (.vscode)
.vscode/